{
  "manifest_version": 3,
  "name": "AUTOMULA — FormPilot AI",
  "version": "0.2.0",
  "description": "Understand forms, prepare grounded answers, and fill approved fields.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "https://automula.vercel.app/*",
    "https://automula-git-phase-2-core-workflows-newaznezifs-projects.vercel.app/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "externally_connectable": {
    "matches": [
      "https://automula.vercel.app/*",
      "https://automula-git-phase-2-core-workflows-newaznezifs-projects.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AUTOMULA"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
